<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">Dueños</h1>
    <a href="/owners/new" class="btn btn-primary">Nuevo Dueño</a>
</div>

<% if (typeof query !== 'undefined' && query.msg) { %>
<div class="alert alert-info"><%= query.msg %></div>
<% } %>

<div class="row">
    <% if (owners.length === 0) { %>
    <div class="col-12 text-center py-5">
        <p class="text-muted">No hay dueños registrados.</p>
        <a href="/owners/new" class="btn btn-primary">Registrar primer dueño</a>
    </div>
    <% } else { %>
    <% owners.forEach(owner => { %>
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title text-primary"><%= owner.name %></h5>
                <p class="card-text mb-1"><strong>Teléfono:</strong> <%= owner.phone || '-' %></p>
                <p class="card-text"><strong>Email:</strong> <%= owner.email || '-' %></p>
            </div>
        </div>
    </div>
    <% }); %>
    <% } %>
</div>
